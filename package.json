{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Rastreador Simples de Metas e Aportes",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "npm run test:unit && npm run test:api && npm run test:smoke",
    "test:unit": "mocha \"tests/unit/**/*.test.js\" --exit",
    "test:api": "mocha \"tests/api/**/*.test.js\" --reporter mochawesome --reporter-options reportDir=mochawesome-report/api,reportFilename=api-tests,quiet=true,overwrite=true,html=true,json=true --exit",
    "test:smoke": "mocha \"tests/smoke/**/*.test.js\" --exit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "mochawesome": "^8.0.1",
    "supertest": "^7.2.2"
  }
}
